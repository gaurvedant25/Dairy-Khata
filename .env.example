# Neon Postgres connection string (get from https://console.neon.tech → your project → "Connection string")
# Example: postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Random 32+ byte secret used to sign session JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Tells Auth.js to trust the deployed host (required on Netlify).
AUTH_TRUST_HOST="true"

# Pin the server clock to India time so "today" and the monthly billing
# boundary roll over at IST midnight, not at 05:30 IST (UTC midnight) on Vercel.
# The app also enforces IST in code (src/lib/date.ts), so this is a backstop —
# set it in the Vercel dashboard (Settings → Environment Variables) too.
TZ="Asia/Kolkata"
