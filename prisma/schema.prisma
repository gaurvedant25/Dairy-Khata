// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  trialEndsAt  DateTime?
  paidUntil    DateTime?

  // Razorpay autopay (UPI mandate) subscription
  razorpaySubscriptionId String?
  subscriptionStatus     String? // created | authenticated | active | cancelled | halted | completed

  setting        Setting?
  customers      Customer[]
  oneTimeOrders  OneTimeOrder[]
  customProducts CustomProduct[]
}

model CustomProduct {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  unit         String
  pricePerUnit Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Setting {
  id                     String @id @default(cuid())
  userId                 String @unique
  user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName           String @default("My Dairy")
  defaultPricePerUnit    Float  @default(60)
  defaultCostPerUnit     Float  @default(45)
  defaultChaiPricePerCup   Float @default(10)
  defaultDahiPricePerCup   Float @default(20)
  defaultPaneerPricePerPiece Float @default(80)
  reminderDayOfMonth       Int   @default(28)
  starredProducts          String[] @default([])
}

model Customer {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  address             String?
  defaultPricePerUnit Float?
  // Per-customer price overrides, keyed by product name: { "Milk": 55, ... }.
  // When set for a product, it wins over the global CustomProduct price.
  customRates         Json?
  dailyQuantity       Float    @default(1)
  manualTrustRating   Int?
  lastReminderSentAt  DateTime?
  createdAt           DateTime  @default(now())
  active              Boolean   @default(true)
  sample              Boolean   @default(false) // seeded demo data, safe to bulk-remove

  deliveries    DeliveryEntry[]
  payments      Payment[]
  oneTimeOrders OneTimeOrder[]

  @@index([userId])
}

model DeliveryEntry {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date         DateTime
  product      String   @default("Milk")
  unit         String   @default("L")
  quantity     Float
  pricePerUnit Float
  costPerUnit  Float
  createdAt    DateTime @default(now())

  @@index([customerId, date])
}

model Payment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  date       DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId, date])
}

// One row per Razorpay payment we've already granted access for, so a charge
// is never counted twice (webhook retries, or verify + webhook both firing).
model ProcessedPayment {
  paymentId String   @id
  userId    String
  createdAt DateTime @default(now())
}

model OneTimeOrder {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  phone        String?
  product      String   @default("Milk")
  unit         String   @default("L")
  quantity     Float    @default(0)
  pricePerUnit Float    @default(0)
  amount       Float
  paid         Boolean  @default(false)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, date])
  @@index([customerId])
}
